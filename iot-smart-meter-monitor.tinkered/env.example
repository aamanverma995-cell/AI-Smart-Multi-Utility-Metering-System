# Copy this file to .env and fill in your values
# cp env.example .env

PZEM_PORT=/dev/ttyUSB0
PZEM_BAUD=9600
WATER_FLOW_GPIO=17
WATER_PULSES_PER_LITRE=7.5
ADS1115_I2C_ADDR=0x48
GAS_CHANNEL=0
GAS_ALERT_THRESHOLD=20000
SAMPLE_INTERVAL_SEC=10
DB_PATH=data/smart_meter.db

MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smart_meter/readings

INFLUX_ENABLED=false
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your-influxdb-token
INFLUX_ORG=your-org
INFLUX_BUCKET=smart_meter

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

ELECTRICITY_POWER_LIMIT_W=3000
WATER_FLOW_LIMIT_LPM=20
ALERT_COOLDOWN_SEC=300

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
